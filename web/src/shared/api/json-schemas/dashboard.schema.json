{
  "$defs": {
    "Accent": {
      "enum": [
        "neutral",
        "blue",
        "green",
        "amber",
        "red",
        "violet",
        "pink",
        "teal"
      ],
      "type": "string",
      "x-open": "neutral"
    },
    "Align": {
      "enum": [
        "start",
        "center",
        "end"
      ],
      "type": "string",
      "x-open": "start"
    },
    "Padding": {
      "enum": [
        "normal",
        "compact",
        "none"
      ],
      "type": "string",
      "x-open": "normal"
    },
    "ResolvedAppearance": {
      "properties": {
        "accent": {
          "$ref": "#/$defs/Accent"
        },
        "align": {
          "$ref": "#/$defs/Align"
        },
        "padding": {
          "$ref": "#/$defs/Padding"
        },
        "surface": {
          "$ref": "#/$defs/Surface"
        },
        "title": {
          "$ref": "#/$defs/TitleVisibility"
        }
      },
      "required": [
        "surface",
        "accent",
        "title",
        "padding",
        "align"
      ],
      "type": "object"
    },
    "ResolvedSectionAppearance": {
      "properties": {
        "surface": {
          "$ref": "#/$defs/SectionSurface"
        },
        "title": {
          "$ref": "#/$defs/TitleVisibility"
        }
      },
      "required": [
        "title",
        "surface"
      ],
      "type": "object"
    },
    "SectionSurface": {
      "enum": [
        "none",
        "card"
      ],
      "type": "string",
      "x-open": "none"
    },
    "SectionView": {
      "properties": {
        "appearance": {
          "$ref": "#/$defs/ResolvedSectionAppearance"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "appearance"
      ],
      "type": "object"
    },
    "Surface": {
      "enum": [
        "card",
        "plain",
        "tinted",
        "outline"
      ],
      "type": "string",
      "x-open": "card"
    },
    "TitleVisibility": {
      "enum": [
        "shown",
        "hidden"
      ],
      "type": "string",
      "x-open": "shown"
    },
    "WidgetHeight": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        }
      ]
    },
    "WidgetView": {
      "properties": {
        "appearance": {
          "$ref": "#/$defs/ResolvedAppearance"
        },
        "column": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "environments": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "height": {
          "$ref": "#/$defs/WidgetHeight"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "public": {
          "type": "boolean"
        },
        "row": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "width": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "type",
        "id",
        "title",
        "settings",
        "section",
        "column",
        "row",
        "width",
        "height",
        "appearance",
        "environments",
        "public"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "sections": {
      "items": {
        "$ref": "#/$defs/SectionView"
      },
      "type": "array"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/WidgetView"
      },
      "type": "array"
    }
  },
  "required": [
    "sections",
    "widgets"
  ],
  "title": "DashboardResponse",
  "type": "object"
}
