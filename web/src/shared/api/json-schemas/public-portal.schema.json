{
  "$defs": {
    "Accent": {
      "enum": [
        "neutral",
        "blue",
        "cyan",
        "teal",
        "green",
        "lime",
        "amber",
        "orange",
        "red",
        "pink",
        "violet",
        "indigo"
      ],
      "type": "string",
      "x-open": "neutral"
    },
    "Align": {
      "enum": [
        "start",
        "center",
        "end"
      ],
      "type": "string",
      "x-open": "start"
    },
    "Diagnosis": {
      "enum": [
        "local-network-denied",
        "refused",
        "timeout",
        "host-unreachable",
        "name-not-resolved",
        "tls",
        "not-http",
        "http-status",
        "icmp-not-permitted",
        "other"
      ],
      "type": "string",
      "x-open": "other"
    },
    "Environment": {
      "type": "string"
    },
    "Padding": {
      "enum": [
        "normal",
        "compact",
        "none"
      ],
      "type": "string",
      "x-open": "normal"
    },
    "PublicSection": {
      "properties": {
        "appearance": {
          "$ref": "#/$defs/ResolvedSectionAppearance"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "appearance"
      ],
      "type": "object"
    },
    "PublicService": {
      "properties": {
        "address": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "group",
        "icon",
        "description",
        "status"
      ],
      "type": "object"
    },
    "PublicWidget": {
      "properties": {
        "appearance": {
          "$ref": "#/$defs/ResolvedAppearance"
        },
        "column": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "$ref": "#/$defs/WidgetHeight"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "width": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "settings",
        "section",
        "column",
        "row",
        "width",
        "height",
        "appearance"
      ],
      "type": "object"
    },
    "ResolvedAppearance": {
      "properties": {
        "accent": {
          "$ref": "#/$defs/Accent"
        },
        "align": {
          "$ref": "#/$defs/Align"
        },
        "padding": {
          "$ref": "#/$defs/Padding"
        },
        "surface": {
          "$ref": "#/$defs/Surface"
        },
        "title": {
          "$ref": "#/$defs/TitleVisibility"
        }
      },
      "required": [
        "surface",
        "accent",
        "title",
        "padding",
        "align"
      ],
      "type": "object"
    },
    "ResolvedSectionAppearance": {
      "properties": {
        "surface": {
          "$ref": "#/$defs/SectionSurface"
        },
        "title": {
          "$ref": "#/$defs/TitleVisibility"
        }
      },
      "required": [
        "title",
        "surface"
      ],
      "type": "object"
    },
    "SectionSurface": {
      "enum": [
        "none",
        "card"
      ],
      "type": "string",
      "x-open": "none"
    },
    "ServiceState": {
      "enum": [
        "unknown",
        "up",
        "degraded",
        "down",
        "unreadable"
      ],
      "type": "string",
      "x-open": "unknown"
    },
    "ServiceStatus": {
      "properties": {
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnosis": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnosis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_ok_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "latency_milliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "since": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ServiceState"
        }
      },
      "required": [
        "state",
        "checked_at",
        "latency_milliseconds",
        "last_ok_at",
        "last_error",
        "diagnosis",
        "since"
      ],
      "type": "object"
    },
    "Surface": {
      "enum": [
        "card",
        "plain",
        "tinted",
        "outline"
      ],
      "type": "string",
      "x-open": "card"
    },
    "TitleVisibility": {
      "enum": [
        "shown",
        "hidden"
      ],
      "type": "string",
      "x-open": "shown"
    },
    "WidgetHeight": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "detected": {
      "$ref": "#/$defs/Environment"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "environments": {
      "items": {
        "$ref": "#/$defs/Environment"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/PublicSection"
      },
      "type": "array"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/PublicService"
      },
      "type": "array"
    },
    "switchable": {
      "type": "boolean"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/PublicWidget"
      },
      "type": "array"
    }
  },
  "required": [
    "environment",
    "detected",
    "switchable",
    "sections",
    "services",
    "widgets"
  ],
  "title": "PortalResponse",
  "type": "object"
}
