            },
            {
              "detail": "then",
              "duration_milliseconds": 120,
              "item": null,
              "iteration": null,
              "kind": "if",
              "label": "down",
              "level": null,
              "log": [
                "\"down\" equals \"down\": yes",
                "took then"
              ],
              "log_dropped": 0,
              "outcome": "succeeded",
              "output": null,
              "path": "steps[1]",
              "shape": null,
              "started_at": "2026-09-25T03:00:00Z",
              "step": "down",
              "values": [
                {
                  "template": "{{steps.first_probe.state}}",
                  "value": "\"down\""
                }
              ],
              "values_dropped": 0
            }
          ]
        },
        "workflow": "revive"
      },
      "steps": [
        {
          "id": "first_probe",
          "kind": "probe",
          "label": "Probe it now",
          "service": "{{inputs.service}}"
        },
        {
          "condition": {
            "left": "{{steps.first_probe.state}}",
            "op": "!=",
            "right": "up"
          },
          "id": "down",
          "kind": "if",
          "then": [
            {
              "body": [
                {
                  "fail_on_error": false,
                  "id": "restart",
                  "kind": "http",
                  "method": "POST",
                  "url": "http://192.168.1.10:9000/restart/{{inputs.service}}"
                },
                {
                  "id": "settle",
                  "kind": "wait",
                  "seconds": 20
                }
              ],
              "id": "retry",
              "kind": "loop",
              "repeat": 3
            }
          ]
        },
        {
          "branches": [
            [
              {
                "id": "nas_state",
                "kind": "status",
                "service": "nas"
              }
            ],
            [
              {
                "id": "router_state",
                "kind": "status",
                "service": "router"
              }
            ]
          ],
          "id": "both",
          "kind": "parallel"
        },
        {
          "id": "tell",
          "kind": "telegram",
          "text": "{{inputs.service}} is {{steps.nas_state.state}}"
        }
      ],
      "steps_version": "5d41402abc4b",
      "tags": [
        "media"
      ],
      "timeout_seconds": 600,
      "title": "Revive a service",
      "used_by": [
        {
          "id": "nas-down",
