{
  "workflows": [
    {
      "active_run": null,
      "description": "Probe, retry the restart API three times, then report",
      "enabled": true,
      "id": "revive",
      "inputs": [
        {
          "default": null,
          "description": null,
          "name": "service",
          "type": "text"
        },
        {
          "default": 3,
          "description": "How many restarts to try",
          "name": "tries",
          "type": "number"
        }
      ],
      "last_run": {
        "arguments": [
