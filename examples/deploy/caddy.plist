<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A launchd agent for Caddy, the reverse proxy the portal manages (the [proxy] section).
  Caddy 2.8 or later: brew install caddy

    cp caddy.plist ~/Library/LaunchAgents/lan.home.caddy.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/lan.home.caddy.plist

  Caddy starts without a Caddyfile and with the resume flag (see ProgramArguments): it
  loads the last configuration the portal gave it, so published services keep working while the portal restarts or is down.
  Hosts that ask for the portal's sign-in answer 502 until the portal is back.
  The portal owns Caddy's whole configuration: a site added to Caddy by hand is removed
  within a minute. Publish anything else as a service with a proxy table.

  The admin API listens on 127.0.0.1:2019, as proxy.admin expects by default. Keep it on
  loopback: it has no password.

  Ports. Caddy listens on 443, and on 80 to redirect to https. macOS lets an ordinary user
  bind them since 10.14. For Let's Encrypt (proxy.tls.mode = "acme") forward ports 80 and
  443 of the router to this machine; hosts with mode "internal" or "files" need no
  forwarding.

  Local Network permission: like the portal, Caddy needs it to reach services on the LAN.
  If proxied pages fail with "no route to host", allow caddy in System Settings >
  Privacy & Security > Local Network.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>lan.home.caddy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/caddy</string>
    <string>run</string>
    <string>--resume</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/me/home-portal</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/me/home-portal/caddy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/me/home-portal/caddy.log</string>
</dict>
</plist>
